{
  "name": "pi-sub-quota",
  "version": "0.1.0",
  "description": "Coding-plan quota and prepaid balance in the pi footer, shown only while a subscription provider such as ZAI/GLM, DeepSeek, or Kimi is active",
  "keywords": [
    "pi-package",
    "pi-extension",
    "quota",
    "subscription",
    "coding-plan",
    "statusline"
  ],
  "license": "MIT",
  "private": false,
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ningh123/pi-sub-quota.git"
  },
  "bugs": {
    "url": "https://github.com/ningh123/pi-sub-quota/issues"
  },
  "homepage": "https://github.com/ningh123/pi-sub-quota#readme",
  "author": {
    "name": "Ning",
    "email": "ningh@ohmrabbit.com"
  },
  "files": [
    "index.ts",
    "providers",
    "cache.ts",
    "stats.ts",
    "view.ts",
    "footer.ts",
    "settings.ts"
  ],
  "exports": {
    ".": "./index.ts"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  },
  "scripts": {
    "test": "node --test \"__tests__/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "prepublishOnly": "npm run typecheck && npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@types/node": "^25.9.1",
    "typescript": "^5.9.3"
  }
}
