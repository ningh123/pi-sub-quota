{
	"compilerOptions": {
		"target": "es2022",
		"module": "esnext",
		"moduleResolution": "bundler",
		"strict": true,
		"noEmit": true,
		"skipLibCheck": true,
		"allowImportingTsExtensions": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"types": [
			"node"
		]
	},
	"include": ["index.ts", "providers/**/*.ts", "cache.ts", "stats.ts", "view.ts", "footer.ts", "settings.ts", "__tests__/*.ts"]
}
